rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Primitive Helpers ---
    // Authenticated non-anonymous user (supports both Google OAuth and Super-Admin-provisioned Email/Password users)
    function hasAuth() {
      return request.auth != null && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    // Verified email is strictly required before trusting token.email against employee records or admin email
    function hasVerifiedEmail() {
      return hasAuth() && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isBootstrappedAdmin() {
      return hasVerifiedEmail() && request.auth.token.email == 'enquiry.revivo@gmail.com';
    }

    function isSuperAdmin() {
      return isBootstrappedAdmin() || (
        hasAuth() &&
        exists(/databases/$(database)/documents/roles/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/roles/$(request.auth.uid)).data.role == 'super_admin' &&
        get(/databases/$(database)/documents/roles/$(request.auth.uid)).data.status == 'Active'
      );
    }

    function isTeamLeader() {
      return hasAuth() &&
        exists(/databases/$(database)/documents/roles/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/roles/$(request.auth.uid)).data.role == 'team_leader' &&
        get(/databases/$(database)/documents/roles/$(request.auth.uid)).data.status == 'Active';
    }

    function isActiveEmployee() {
      return isBootstrappedAdmin() || (
        hasAuth() &&
        exists(/databases/$(database)/documents/roles/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/roles/$(request.auth.uid)).data.status == 'Active'
      );
    }

    function hasLeaderPermission(permKey) {
      return isTeamLeader() &&
        exists(/databases/$(database)/documents/companySettings/main) &&
        get(/databases/$(database)/documents/companySettings/main).data.teamLeaderPermissions[permKey] == true;
    }

    function isLeaderOrAdmin() {
      return isSuperAdmin() || isTeamLeader();
    }

    function isStringSize(val, minLen, maxLen) {
      return val is string && val.size() >= minLen && val.size() <= maxLen;
    }

    function isOptionalStringSize(data, field, maxLen) {
      return !(field in data) || (data[field] is string && data[field].size() <= maxLen);
    }

    // --- Validation Blueprints ---
    function isValidCompanySettings(data) {
      return data.keys().hasAll([
          'companyName', 'officeStartTime', 'officeEndTime', 'gracePeriodMinutes',
          'halfDayMinHours', 'fullDayMinHours', 'workingDays', 'defaultSickLeave',
          'defaultCasualLeave', 'currency', 'teamLeaderPermissions', 'updatedAt', 'updatedBy'
        ]) &&
        data.keys().hasOnly([
          'companyName', 'companyAddress', 'companyPhone', 'companyEmail', 'companyWebsite',
          'taxId', 'logoAssetId', 'companies', 'locations', 'supportedCurrencies',
          'officeStartTime', 'officeEndTime', 'gracePeriodMinutes',
          'halfDayMinHours', 'fullDayMinHours', 'workingDays', 'holidays',
          'defaultSickLeave', 'defaultCasualLeave', 'leavePolicy', 'celebrationSettings', 'attendanceReminders', 'currency', 'teamLeaderPermissions',
          'updatedAt', 'updatedBy'
        ]) &&
        isStringSize(data.companyName, 1, 120) &&
        isOptionalStringSize(data, 'companyAddress', 300) &&
        isOptionalStringSize(data, 'companyPhone', 40) &&
        isOptionalStringSize(data, 'companyEmail', 120) &&
        isOptionalStringSize(data, 'companyWebsite', 160) &&
        isOptionalStringSize(data, 'taxId', 80) &&
        isOptionalStringSize(data, 'logoAssetId', 128) &&
        (!( 'companies' in data ) || data.companies is map) &&
        (!( 'locations' in data ) || (data.locations is list && data.locations.size() <= 20)) &&
        (!( 'supportedCurrencies' in data ) || (data.supportedCurrencies is list && data.supportedCurrencies.size() <= 10)) &&
        isStringSize(data.officeStartTime, 5, 5) &&
        isStringSize(data.officeEndTime, 5, 5) &&
        data.gracePeriodMinutes is number && data.gracePeriodMinutes >= 0 && data.gracePeriodMinutes <= 180 &&
        data.halfDayMinHours is number && data.halfDayMinHours >= 1 && data.halfDayMinHours <= 12 &&
        data.fullDayMinHours is number && data.fullDayMinHours >= 1 && data.fullDayMinHours <= 16 &&
        data.workingDays is list && data.workingDays.size() <= 7 &&
        (!( 'holidays' in data ) || (data.holidays is list && data.holidays.size() <= 60)) &&
        data.defaultSickLeave is number && data.defaultSickLeave >= 0 && data.defaultSickLeave <= 100 &&
        data.defaultCasualLeave is number && data.defaultCasualLeave >= 0 && data.defaultCasualLeave <= 100 &&
        (!( 'leavePolicy' in data ) || data.leavePolicy is map) &&
        (!( 'celebrationSettings' in data ) || data.celebrationSettings is map) &&
        (!( 'attendanceReminders' in data ) || data.attendanceReminders is map) &&
        isStringSize(data.currency, 1, 10) &&
        data.teamLeaderPermissions is map &&
        data.updatedAt == request.time &&
        isStringSize(data.updatedBy, 1, 128);
    }

    function isValidDepartment(data) {
      return data.keys().hasAll(['name', 'code', 'createdAt']) &&
        data.keys().hasOnly(['name', 'code', 'managerUid', 'createdAt']) &&
        isStringSize(data.name, 1, 80) &&
        isStringSize(data.code, 1, 20) &&
        isOptionalStringSize(data, 'managerUid', 128) &&
        data.createdAt is timestamp;
    }

    function isValidRoleEntry(data) {
      return data.keys().hasAll(['uid', 'email', 'role', 'employeeId', 'status', 'updatedAt']) &&
        data.keys().hasOnly(['uid', 'email', 'role', 'employeeId', 'status', 'updatedAt']) &&
        isStringSize(data.uid, 1, 128) &&
        isStringSize(data.email, 3, 120) &&
        data.role in ['super_admin', 'team_leader', 'employee'] &&
        isStringSize(data.employeeId, 1, 128) &&
        data.status in ['Active', 'Inactive', 'Resigned', 'Terminated'] &&
        data.updatedAt == request.time;
    }

    function isValidEmployee(data) {
      return data.keys().hasAll([
          'uid', 'employeeCode', 'fullName', 'email', 'role', 'department',
          'designation', 'joiningDate', 'status', 'sickLeaveBalance',
          'casualLeaveBalance', 'carryForwardBalance', 'mustChangePassword',
          'failedLoginAttempts', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'uid', 'companyId', 'employeeCode', 'fullName', 'email', 'phone', 'emergencyContact',
          'role', 'department', 'designation', 'joiningDate', 'dateOfBirth', 'birthdayMonthDay', 'status',
          'location', 'timezone', 'currency',
          'officeStartTime', 'officeEndTime', 'gracePeriodMinutes',
          'halfDayMinHours', 'fullDayMinHours', 'workingDays',
          'managerUid', 'profilePhotoAssetId', 'sickLeaveBalance', 'casualLeaveBalance',
          'carryForwardBalance', 'leavePolicyMigrated', 'leaveBaselineMonth', 'leaveLastSyncedMonth',
          'leaveLastResetYear', 'clEligibilityDate', 'clEligibilityCustom', 'leaveMigrationNote', 'reminderPreferences',
          'mustChangePassword', 'failedLoginAttempts',
          'lockedUntil', 'createdAt', 'updatedAt'
        ]) &&
        data.uid is string && data.uid.size() <= 128 &&
        (!( 'companyId' in data ) || data.companyId in ['talentgrade', 'mygrade']) &&
        isStringSize(data.employeeCode, 1, 40) &&
        isStringSize(data.fullName, 1, 120) &&
        isStringSize(data.email, 3, 120) &&
        isOptionalStringSize(data, 'phone', 40) &&
        isOptionalStringSize(data, 'emergencyContact', 120) &&
        data.role in ['super_admin', 'team_leader', 'employee'] &&
        isStringSize(data.department, 1, 80) &&
        isStringSize(data.designation, 1, 80) &&
        isStringSize(data.joiningDate, 10, 10) &&
        (!( 'dateOfBirth' in data ) || data.dateOfBirth == '' || (data.dateOfBirth is string && data.dateOfBirth.matches('^\\d{4}-\\d{2}-\\d{2}$'))) &&
        (!( 'birthdayMonthDay' in data ) || data.birthdayMonthDay == '' || (data.birthdayMonthDay is string && data.birthdayMonthDay.matches('^\\d{2}-\\d{2}$'))) &&
        data.status in ['Active', 'Inactive', 'Resigned', 'Terminated'] &&
        isOptionalStringSize(data, 'location', 80) &&
        isOptionalStringSize(data, 'timezone', 80) &&
        isOptionalStringSize(data, 'currency', 10) &&
        (!( 'companyId' in data ) || data.companyId != 'mygrade' || !( 'currency' in data ) || data.currency == 'INR') &&
        isOptionalStringSize(data, 'officeStartTime', 5) &&
        isOptionalStringSize(data, 'officeEndTime', 5) &&
        (!( 'gracePeriodMinutes' in data ) || (data.gracePeriodMinutes is number && data.gracePeriodMinutes >= 0 && data.gracePeriodMinutes <= 180)) &&
        (!( 'halfDayMinHours' in data ) || (data.halfDayMinHours is number && data.halfDayMinHours >= 0.5 && data.halfDayMinHours <= 12)) &&
        (!( 'fullDayMinHours' in data ) || (data.fullDayMinHours is number && data.fullDayMinHours >= 1 && data.fullDayMinHours <= 16)) &&
        (!( 'workingDays' in data ) || (data.workingDays is list && data.workingDays.size() <= 7)) &&
        isOptionalStringSize(data, 'managerUid', 128) &&
        isOptionalStringSize(data, 'profilePhotoAssetId', 128) &&
        data.sickLeaveBalance is number && data.sickLeaveBalance >= -60 && data.sickLeaveBalance <= 365 &&
        data.casualLeaveBalance is number && data.casualLeaveBalance >= -60 && data.casualLeaveBalance <= 365 &&
        data.carryForwardBalance is number && data.carryForwardBalance >= 0 && data.carryForwardBalance <= 365 &&
        (!( 'leavePolicyMigrated' in data ) || data.leavePolicyMigrated is bool) &&
        isOptionalStringSize(data, 'leaveBaselineMonth', 7) &&
        isOptionalStringSize(data, 'leaveLastSyncedMonth', 7) &&
        (!( 'leaveLastResetYear' in data ) || (data.leaveLastResetYear is number && data.leaveLastResetYear >= 2000 && data.leaveLastResetYear <= 2100)) &&
        isOptionalStringSize(data, 'clEligibilityDate', 10) &&
        (!( 'clEligibilityCustom' in data ) || data.clEligibilityCustom is bool) &&
        isOptionalStringSize(data, 'leaveMigrationNote', 300) &&
        (!( 'reminderPreferences' in data ) || data.reminderPreferences is map) &&
        data.mustChangePassword is bool &&
        data.failedLoginAttempts is number && data.failedLoginAttempts >= 0 && data.failedLoginAttempts <= 20 &&
        isOptionalStringSize(data, 'lockedUntil', 40) &&
        data.createdAt is timestamp &&
        data.updatedAt == request.time;
    }

    function isValidEmployeeSalary(data) {
      return data.keys().hasAll([
          'employeeId', 'employeeUid', 'basicSalary', 'hra', 'otherEarnings',
          'deductions', 'professionalTax', 'defaultBonus', 'netSalary', 'updatedAt', 'updatedBy'
        ]) &&
        data.keys().hasOnly([
          'employeeId', 'employeeUid', 'currency', 'basicSalary', 'hra', 'otherEarnings',
          'deductions', 'professionalTax', 'defaultBonus', 'netSalary', 'updatedAt', 'updatedBy'
        ]) &&
        isStringSize(data.employeeId, 1, 128) &&
        data.employeeUid is string && data.employeeUid.size() <= 128 &&
        isOptionalStringSize(data, 'currency', 10) &&
        data.basicSalary is number && data.basicSalary >= 0 &&
        data.hra is number && data.hra >= 0 &&
        data.otherEarnings is list && data.otherEarnings.size() <= 15 &&
        data.deductions is list && data.deductions.size() <= 15 &&
        data.professionalTax is number && data.professionalTax >= 0 &&
        data.defaultBonus is number && data.defaultBonus >= 0 &&
        data.netSalary is number &&
        data.updatedAt == request.time &&
        isStringSize(data.updatedBy, 1, 128);
    }

    function isValidAttendanceRecord(data) {
      return data.keys().hasAll([
          'employeeId', 'employeeUid', 'employeeName', 'department', 'date',
          'workingMinutes', 'status', 'isLate', 'lateByMinutes', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'employeeId', 'employeeUid', 'employeeName', 'department', 'managerUid', 'date', 'timezone',
          'punchInTime', 'punchInLat', 'punchInLng', 'punchInAccuracy', 'punchInPhotoId',
          'punchOutTime', 'punchOutLat', 'punchOutLng', 'punchOutAccuracy', 'punchOutPhotoId',
          'workingMinutes', 'status', 'isLate', 'lateByMinutes', 'notes', 'createdAt', 'updatedAt'
        ]) &&
        isStringSize(data.employeeId, 1, 128) &&
        isStringSize(data.employeeUid, 1, 128) &&
        isStringSize(data.employeeName, 1, 120) &&
        isStringSize(data.department, 1, 80) &&
        isOptionalStringSize(data, 'managerUid', 128) &&
        isStringSize(data.date, 10, 10) &&
        isOptionalStringSize(data, 'timezone', 80) &&
        isOptionalStringSize(data, 'punchInTime', 40) &&
        (!( 'punchInLat' in data ) || data.punchInLat is number) &&
        (!( 'punchInLng' in data ) || data.punchInLng is number) &&
        (!( 'punchInAccuracy' in data ) || data.punchInAccuracy is number) &&
        isOptionalStringSize(data, 'punchInPhotoId', 128) &&
        isOptionalStringSize(data, 'punchOutTime', 40) &&
        (!( 'punchOutLat' in data ) || data.punchOutLat is number) &&
        (!( 'punchOutLng' in data ) || data.punchOutLng is number) &&
        (!( 'punchOutAccuracy' in data ) || data.punchOutAccuracy is number) &&
        isOptionalStringSize(data, 'punchOutPhotoId', 128) &&
        data.workingMinutes is number && data.workingMinutes >= 0 && data.workingMinutes <= 1440 &&
        data.status in ['Present', 'Late', 'Half Day', 'Absent', 'Leave', 'Incomplete Attendance', 'Holiday', 'Weekly Off'] &&
        data.isLate is bool &&
        data.lateByMinutes is number && data.lateByMinutes >= 0 && data.lateByMinutes <= 1440 &&
        isOptionalStringSize(data, 'notes', 500) &&
        data.createdAt is timestamp &&
        data.updatedAt == request.time;
    }

    function isValidAttendancePhoto(data) {
      return data.keys().hasAll([
          'employeeId', 'employeeUid', 'attendanceRecordId', 'punchType',
          'date', 'capturedAt', 'mimeType', 'dataUrl'
        ]) &&
        data.keys().hasOnly([
          'employeeId', 'employeeUid', 'managerUid', 'attendanceRecordId', 'punchType',
          'date', 'capturedAt', 'mimeType', 'dataUrl'
        ]) &&
        isStringSize(data.employeeId, 1, 128) &&
        isStringSize(data.employeeUid, 1, 128) &&
        isOptionalStringSize(data, 'managerUid', 128) &&
        isStringSize(data.attendanceRecordId, 1, 160) &&
        data.punchType in ['in', 'out'] &&
        isStringSize(data.date, 10, 10) &&
        data.capturedAt == request.time &&
        data.mimeType in ['image/jpeg', 'image/png', 'image/webp'] &&
        isStringSize(data.dataUrl, 30, 750000);
    }

    function isValidMediaAsset(data) {
      return data.keys().hasAll(['ownerUid', 'assetType', 'fileName', 'mimeType', 'dataUrl', 'createdAt']) &&
        data.keys().hasOnly(['ownerUid', 'assetType', 'fileName', 'mimeType', 'dataUrl', 'createdAt']) &&
        isStringSize(data.ownerUid, 1, 128) &&
        data.assetType in ['company_logo', 'profile_photo', 'attachment'] &&
        isStringSize(data.fileName, 1, 160) &&
        isStringSize(data.mimeType, 3, 80) &&
        isStringSize(data.dataUrl, 10, 750000) &&
        data.createdAt == request.time;
    }

    function isValidAttendanceCorrection(data) {
      return data.keys().hasAll([
          'employeeId', 'employeeUid', 'employeeName', 'department', 'date',
          'attendanceRecordId', 'requestedPunchIn', 'requestedPunchOut', 'reason', 'status', 'createdAt'
        ]) &&
        data.keys().hasOnly([
          'employeeId', 'employeeUid', 'employeeCode', 'employeeName', 'department', 'managerUid',
          'date', 'timezone', 'attendanceRecordId', 'requestType',
          'requestedPunchIn', 'requestedPunchOut',
          'originalPunchInTime', 'originalPunchOutTime', 'originalStatus', 'originalWorkingMinutes',
          'reason', 'attachmentAssetId', 'status', 'reviewedBy', 'reviewedByName', 'reviewedByRole',
          'reviewComment', 'appliedChanges', 'submittedAtIso', 'reviewedAt', 'createdAt'
        ]) &&
        isStringSize(data.employeeId, 1, 128) &&
        isStringSize(data.employeeUid, 1, 128) &&
        isOptionalStringSize(data, 'employeeCode', 40) &&
        isStringSize(data.employeeName, 1, 120) &&
        isStringSize(data.department, 1, 80) &&
        isOptionalStringSize(data, 'managerUid', 128) &&
        data.date is string && data.date.matches('^\\d{4}-\\d{2}-\\d{2}$') &&
        isOptionalStringSize(data, 'timezone', 80) &&
        isStringSize(data.attendanceRecordId, 1, 160) &&
        (!( 'requestType' in data ) || data.requestType in ['missed_punch_in', 'missed_punch_out', 'both_missed', 'incorrect_punch', 'other_discrepancy']) &&
        isStringSize(data.requestedPunchIn, 0, 5) &&
        (data.requestedPunchIn == '' || data.requestedPunchIn.matches('^([01]\\d|2[0-3]):[0-5]\\d$')) &&
        isStringSize(data.requestedPunchOut, 0, 5) &&
        (data.requestedPunchOut == '' || data.requestedPunchOut.matches('^([01]\\d|2[0-3]):[0-5]\\d$')) &&
        isOptionalStringSize(data, 'originalPunchInTime', 40) &&
        isOptionalStringSize(data, 'originalPunchOutTime', 40) &&
        (!( 'originalStatus' in data ) || data.originalStatus in ['Present', 'Late', 'Half Day', 'Absent', 'Leave', 'Incomplete Attendance', 'Holiday', 'Weekly Off']) &&
        (!( 'originalWorkingMinutes' in data ) || (data.originalWorkingMinutes is number && data.originalWorkingMinutes >= 0 && data.originalWorkingMinutes <= 1440)) &&
        isStringSize(data.reason, 3, 500) &&
        isOptionalStringSize(data, 'attachmentAssetId', 128) &&
        data.status in ['Pending', 'Approved', 'Rejected'] &&
        isOptionalStringSize(data, 'reviewedBy', 128) &&
        isOptionalStringSize(data, 'reviewedByName', 120) &&
        (!( 'reviewedByRole' in data ) || data.reviewedByRole in ['super_admin', 'team_leader', 'employee']) &&
        isOptionalStringSize(data, 'reviewComment', 500) &&
        (!( 'appliedChanges' in data ) || data.appliedChanges is map) &&
        isOptionalStringSize(data, 'submittedAtIso', 40) &&
        (!( 'reviewedAt' in data ) || data.reviewedAt is timestamp) &&
        data.createdAt is timestamp;
    }

    function isValidRegularizationLock(data) {
      return data.keys().hasAll(['employeeId', 'employeeUid', 'date', 'requestType', 'correctionId', 'createdAt']) &&
        data.keys().hasOnly(['employeeId', 'employeeUid', 'date', 'requestType', 'correctionId', 'createdAt']) &&
        isStringSize(data.employeeId, 1, 128) &&
        isStringSize(data.employeeUid, 1, 128) &&
        data.date is string && data.date.matches('^\\d{4}-\\d{2}-\\d{2}$') &&
        data.requestType in ['missed_punch_in', 'missed_punch_out', 'both_missed', 'incorrect_punch', 'other_discrepancy'] &&
        isStringSize(data.correctionId, 1, 128) &&
        data.createdAt == request.time;
    }

    function isValidHrNotification(data) {
      return data.keys().hasAll([
          'category', 'eventType', 'audienceType', 'requestId', 'employeeId',
          'employeeName', 'department', 'attendanceDate', 'requestType',
          'title', 'message', 'actorUid', 'actorName', 'createdAt'
        ]) &&
        data.keys().hasOnly([
          'category', 'eventType', 'audienceType', 'targetUid', 'requestId',
          'employeeId', 'employeeCode', 'employeeName', 'department', 'attendanceDate',
          'requestType', 'title', 'message', 'note', 'actorUid', 'actorName', 'createdAt'
        ]) &&
        data.category == 'regularization' &&
        data.eventType in ['submitted_confirmation', 'submitted_admin', 'approved', 'rejected'] &&
        data.audienceType in ['user', 'reviewers'] &&
        isOptionalStringSize(data, 'targetUid', 128) &&
        isStringSize(data.requestId, 1, 128) &&
        isStringSize(data.employeeId, 1, 128) &&
        isOptionalStringSize(data, 'employeeCode', 40) &&
        isStringSize(data.employeeName, 1, 120) &&
        isStringSize(data.department, 1, 80) &&
        data.attendanceDate is string && data.attendanceDate.matches('^\\d{4}-\\d{2}-\\d{2}$') &&
        data.requestType in ['missed_punch_in', 'missed_punch_out', 'both_missed', 'incorrect_punch', 'other_discrepancy'] &&
        isStringSize(data.title, 1, 160) &&
        isStringSize(data.message, 1, 400) &&
        isOptionalStringSize(data, 'note', 500) &&
        isStringSize(data.actorUid, 1, 128) &&
        data.actorUid == request.auth.uid &&
        isStringSize(data.actorName, 1, 120) &&
        data.createdAt == request.time;
    }

    function isValidLeaveApplication(data) {
      return data.keys().hasAll([
          'employeeId', 'employeeUid', 'employeeName', 'department', 'leaveType',
          'startDate', 'endDate', 'days', 'reason', 'status', 'balanceDeducted', 'deductedAmount', 'createdAt'
        ]) &&
        data.keys().hasOnly([
          'employeeId', 'employeeUid', 'employeeName', 'department', 'managerUid', 'leaveType',
          'startDate', 'endDate', 'days', 'reason', 'attachmentAssetId', 'status',
          'balanceDeducted', 'deductedAmount', 'reviewedBy', 'reviewedByName', 'reviewComment', 'reviewedAt', 'createdAt'
        ]) &&
        isStringSize(data.employeeId, 1, 128) &&
        isStringSize(data.employeeUid, 1, 128) &&
        isStringSize(data.employeeName, 1, 120) &&
        isStringSize(data.department, 1, 80) &&
        isOptionalStringSize(data, 'managerUid', 128) &&
        data.leaveType in ['SL', 'CL', 'LWP'] &&
        isStringSize(data.startDate, 10, 10) &&
        isStringSize(data.endDate, 10, 10) &&
        data.days is number && data.days > 0 && data.days <= 180 &&
        isStringSize(data.reason, 3, 500) &&
        isOptionalStringSize(data, 'attachmentAssetId', 128) &&
        data.status in ['Pending', 'Approved', 'Rejected', 'Cancelled'] &&
        data.balanceDeducted is bool &&
        data.deductedAmount is number && data.deductedAmount >= 0 && data.deductedAmount <= 180 &&
        isOptionalStringSize(data, 'reviewedBy', 128) &&
        isOptionalStringSize(data, 'reviewedByName', 120) &&
        isOptionalStringSize(data, 'reviewComment', 500) &&
        (!( 'reviewedAt' in data ) || data.reviewedAt is timestamp) &&
        data.createdAt is timestamp;
    }

    function isValidLeaveLedgerEntry(data) {
      return data.keys().hasAll([
          'employeeId', 'employeeUid', 'employeeEmail', 'employeeName', 'leaveType',
          'entryType', 'month', 'year', 'amount', 'source', 'reason', 'createdBy',
          'createdByName', 'createdAt'
        ]) &&
        data.keys().hasOnly([
          'employeeId', 'employeeUid', 'employeeEmail', 'employeeName', 'leaveType',
          'entryType', 'month', 'year', 'amount', 'balanceBefore', 'balanceAfter', 'source',
          'referenceId', 'reason', 'createdBy', 'createdByName', 'createdAt'
        ]) &&
        isStringSize(data.employeeId, 1, 128) &&
        data.employeeUid is string && data.employeeUid.size() <= 128 &&
        isStringSize(data.employeeEmail, 3, 120) &&
        isStringSize(data.employeeName, 1, 120) &&
        data.leaveType in ['SL', 'CL', 'LWP'] &&
        data.entryType in ['monthly_accrual', 'monthly_expiry', 'year_reset', 'carry_forward', 'approved_deduction', 'leave_reversal', 'admin_adjustment', 'migration_baseline', 'opening_balance'] &&
        isStringSize(data.month, 7, 7) &&
        data.year is number && data.year >= 2000 && data.year <= 2100 &&
        data.amount is number && data.amount >= -365 && data.amount <= 365 &&
        (!( 'balanceBefore' in data ) || (data.balanceBefore is number && data.balanceBefore >= -365 && data.balanceBefore <= 365)) &&
        (!( 'balanceAfter' in data ) || (data.balanceAfter is number && data.balanceAfter >= -365 && data.balanceAfter <= 365)) &&
        data.source in ['accrual_engine', 'annual_cycle', 'leave_approval', 'leave_reversal', 'admin_manual', 'legacy_migration'] &&
        isOptionalStringSize(data, 'referenceId', 160) &&
        isStringSize(data.reason, 1, 500) &&
        isStringSize(data.createdBy, 1, 128) &&
        data.createdBy == request.auth.uid &&
        isStringSize(data.createdByName, 1, 120) &&
        data.createdAt == request.time;
    }

    function isValidPayrollRecord(data) {
      return data.keys().hasAll([
          'employeeId', 'employeeUid', 'employeeName', 'employeeCode', 'designation',
          'department', 'month', 'basicSalary', 'hra', 'otherEarnings', 'bonus',
          'deductions', 'professionalTax', 'grossEarnings', 'totalDeductions', 'netSalary',
          'workingDaysInMonth', 'presentDays', 'leaveDays', 'status', 'createdBy', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'employeeId', 'employeeUid', 'employeeName', 'employeeCode', 'designation',
          'department', 'companyId', 'companyName', 'companyAddress', 'companyLogoAssetId',
          'companyOverridden', 'generatedAtIso', 'location', 'currency', 'month', 'basicSalary', 'hra', 'otherEarnings', 'bonus',
          'deductions', 'professionalTax', 'grossEarnings', 'totalDeductions', 'netSalary',
          'workingDaysInMonth', 'presentDays', 'leaveDays', 'status', 'notes',
          'createdBy', 'createdAt', 'updatedAt', 'publishedAt'
        ]) &&
        isStringSize(data.employeeId, 1, 128) &&
        data.employeeUid is string && data.employeeUid.size() <= 128 &&
        isStringSize(data.employeeName, 1, 120) &&
        isStringSize(data.employeeCode, 1, 40) &&
        isStringSize(data.designation, 1, 80) &&
        isStringSize(data.department, 1, 80) &&
        (!( 'companyId' in data ) || data.companyId in ['talentgrade', 'mygrade']) &&
        isOptionalStringSize(data, 'companyName', 160) &&
        isOptionalStringSize(data, 'companyAddress', 300) &&
        isOptionalStringSize(data, 'companyLogoAssetId', 128) &&
        (!( 'companyOverridden' in data ) || data.companyOverridden is bool) &&
        isOptionalStringSize(data, 'generatedAtIso', 40) &&
        isOptionalStringSize(data, 'location', 80) &&
        isOptionalStringSize(data, 'currency', 10) &&
        (!( 'companyId' in data ) || data.companyId != 'mygrade' || !( 'currency' in data ) || data.currency == 'INR') &&
        isStringSize(data.month, 7, 7) &&
        data.basicSalary is number && data.basicSalary >= 0 &&
        data.hra is number && data.hra >= 0 &&
        data.otherEarnings is list && data.otherEarnings.size() <= 15 &&
        data.bonus is number && data.bonus >= 0 &&
        data.deductions is list && data.deductions.size() <= 15 &&
        data.professionalTax is number && data.professionalTax >= 0 &&
        data.grossEarnings is number && data.grossEarnings >= 0 &&
        data.totalDeductions is number && data.totalDeductions >= 0 &&
        data.netSalary is number &&
        data.workingDaysInMonth is number && data.workingDaysInMonth >= 0 && data.workingDaysInMonth <= 31 &&
        data.presentDays is number && data.presentDays >= 0 && data.presentDays <= 31 &&
        data.leaveDays is number && data.leaveDays >= 0 && data.leaveDays <= 31 &&
        data.status in ['Draft', 'Finalized', 'Published'] &&
        isOptionalStringSize(data, 'notes', 500) &&
        isStringSize(data.createdBy, 1, 128) &&
        data.createdAt is timestamp &&
        data.updatedAt == request.time &&
        (!( 'publishedAt' in data ) || data.publishedAt is timestamp);
    }

    function isValidAuditLog(data) {
      return data.keys().hasAll([
          'actorUid', 'actorName', 'actorRole', 'action', 'entityType', 'entityId', 'summary', 'createdAt'
        ]) &&
        data.keys().hasOnly([
          'actorUid', 'actorName', 'actorRole', 'action', 'entityType', 'entityId',
          'previousValues', 'updatedValues', 'summary', 'createdAt'
        ]) &&
        isStringSize(data.actorUid, 1, 128) &&
        data.actorUid == request.auth.uid &&
        isStringSize(data.actorName, 1, 120) &&
        isStringSize(data.actorRole, 1, 40) &&
        isStringSize(data.action, 1, 80) &&
        isStringSize(data.entityType, 1, 60) &&
        isStringSize(data.entityId, 1, 160) &&
        (!( 'previousValues' in data ) || data.previousValues is map) &&
        (!( 'updatedValues' in data ) || data.updatedValues is map) &&
        isStringSize(data.summary, 1, 500) &&
        data.createdAt == request.time;
    }

    function isValidCelebrationProfile(data) {
      return data.keys().hasAll([
          'employeeId', 'employeeUid', 'fullName', 'department', 'designation',
          'location', 'status', 'role', 'joiningDate', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'employeeId', 'employeeUid', 'fullName', 'department', 'designation',
          'location', 'status', 'role', 'profilePhotoAssetId', 'birthdayMonthDay',
          'joiningDate', 'updatedAt'
        ]) &&
        isStringSize(data.employeeId, 1, 128) &&
        data.employeeUid is string && data.employeeUid.size() <= 128 &&
        isStringSize(data.fullName, 1, 120) &&
        isStringSize(data.department, 1, 80) &&
        isStringSize(data.designation, 1, 80) &&
        isStringSize(data.location, 1, 80) &&
        data.status in ['Active', 'Inactive', 'Resigned', 'Terminated'] &&
        data.role in ['super_admin', 'team_leader', 'employee'] &&
        isOptionalStringSize(data, 'profilePhotoAssetId', 128) &&
        (!( 'birthdayMonthDay' in data ) || (data.birthdayMonthDay is string && data.birthdayMonthDay.matches('^\\d{2}-\\d{2}$'))) &&
        data.joiningDate is string && data.joiningDate.matches('^\\d{4}-\\d{2}-\\d{2}$') &&
        data.updatedAt == request.time;
    }

    function isValidCelebrationNotification(data) {
      return data.keys().hasAll([
          'type', 'employeeId', 'employeeUid', 'employeeName', 'department', 'designation',
          'celebrationDate', 'celebrationMonthDay', 'year', 'title', 'message',
          'audienceScope', 'createdByUid', 'createdAt'
        ]) &&
        data.keys().hasOnly([
          'type', 'employeeId', 'employeeUid', 'employeeName', 'department', 'designation',
          'profilePhotoAssetId', 'celebrationDate', 'celebrationMonthDay', 'year',
          'yearsCompleted', 'title', 'message', 'audienceScope', 'createdByUid', 'createdAt'
        ]) &&
        data.type in ['birthday', 'anniversary'] &&
        isStringSize(data.employeeId, 1, 128) &&
        data.employeeUid is string && data.employeeUid.size() <= 128 &&
        isStringSize(data.employeeName, 1, 120) &&
        isStringSize(data.department, 1, 80) &&
        data.designation is string && data.designation.size() <= 80 &&
        isOptionalStringSize(data, 'profilePhotoAssetId', 128) &&
        data.celebrationDate is string && data.celebrationDate.matches('^\\d{4}-\\d{2}-\\d{2}$') &&
        data.celebrationMonthDay is string && data.celebrationMonthDay.matches('^\\d{2}-\\d{2}$') &&
        data.year is int && data.year >= 2000 && data.year <= 2100 &&
        (!( 'yearsCompleted' in data ) || (data.yearsCompleted is int && data.yearsCompleted >= 1 && data.yearsCompleted <= 80)) &&
        isStringSize(data.title, 1, 160) &&
        isStringSize(data.message, 1, 300) &&
        data.audienceScope in ['all_active', 'department', 'leaders_only'] &&
        isStringSize(data.createdByUid, 1, 128) &&
        data.createdByUid == request.auth.uid &&
        data.createdAt == request.time;
    }

    function isValidNotificationRead(data) {
      return data.keys().hasAll(['uid', 'notificationId', 'readAt']) &&
        data.keys().hasOnly(['uid', 'notificationId', 'readAt']) &&
        isStringSize(data.uid, 1, 128) &&
        data.uid == request.auth.uid &&
        isStringSize(data.notificationId, 1, 128) &&
        data.readAt == request.time;
    }

    function isValidCelebrationWish(data) {
      return data.keys().hasAll([
          'notificationId', 'type', 'recipientEmployeeId', 'recipientName',
          'authorUid', 'authorEmployeeId', 'authorName', 'authorDepartment',
          'emoji', 'message', 'createdAt'
        ]) &&
        data.keys().hasOnly([
          'notificationId', 'type', 'recipientEmployeeId', 'recipientName',
          'authorUid', 'authorEmployeeId', 'authorName', 'authorDepartment',
          'authorPhotoAssetId', 'emoji', 'message', 'createdAt'
        ]) &&
        isStringSize(data.notificationId, 1, 128) &&
        data.type in ['birthday', 'anniversary'] &&
        isStringSize(data.recipientEmployeeId, 1, 128) &&
        isStringSize(data.recipientName, 1, 120) &&
        isStringSize(data.authorUid, 1, 128) &&
        data.authorUid == request.auth.uid &&
        isStringSize(data.authorEmployeeId, 1, 128) &&
        isStringSize(data.authorName, 1, 120) &&
        isStringSize(data.authorDepartment, 1, 80) &&
        isOptionalStringSize(data, 'authorPhotoAssetId', 128) &&
        data.emoji in ['🎉', '🎂', '👏', '🌟', '💐', '🏆'] &&
        isStringSize(data.message, 1, 400) &&
        data.createdAt == request.time;
    }

    function isValidPushSubscription(data) {
      return data.keys().hasAll([
          'employeeId', 'employeeUid', 'endpoint', 'keys', 'deviceLabel',
          'status', 'createdAtIso', 'updatedAtIso'
        ]) &&
        data.keys().hasOnly([
          'employeeId', 'employeeUid', 'endpoint', 'keys', 'expirationTime',
          'deviceLabel', 'status', 'lastFailureReason', 'createdAtIso', 'updatedAtIso'
        ]) &&
        isStringSize(data.employeeId, 1, 128) &&
        isStringSize(data.employeeUid, 1, 128) &&
        data.employeeUid == request.auth.uid &&
        isStringSize(data.endpoint, 10, 1200) &&
        data.keys is map &&
        (!( 'expirationTime' in data ) || data.expirationTime == null || data.expirationTime is number) &&
        isStringSize(data.deviceLabel, 1, 120) &&
        data.status in ['active', 'expired', 'inactive'] &&
        isOptionalStringSize(data, 'lastFailureReason', 300) &&
        isStringSize(data.createdAtIso, 10, 40) &&
        isStringSize(data.updatedAtIso, 10, 40);
    }

    function isValidAttendanceReminderLog(data) {
      return data.keys().hasAll([
          'dedupKey', 'employeeId', 'employeeUid', 'employeeName', 'department',
          'reminderType', 'attendanceDate', 'title', 'body', 'status', 'sentAtIso'
        ]) &&
        data.keys().hasOnly([
          'dedupKey', 'employeeId', 'employeeUid', 'employeeName', 'department',
          'location', 'reminderType', 'attendanceDate', 'timezone', 'title', 'body',
          'url', 'status', 'reason', 'subscriptionId', 'deviceLabel', 'failureDetail', 'sentAtIso'
        ]) &&
        isStringSize(data.dedupKey, 1, 160) &&
        isStringSize(data.employeeId, 1, 128) &&
        isStringSize(data.employeeUid, 1, 128) &&
        isStringSize(data.employeeName, 1, 120) &&
        isStringSize(data.department, 1, 80) &&
        isOptionalStringSize(data, 'location', 80) &&
        data.reminderType in ['punch_in', 'missed_punch_in', 'punch_out', 'missed_punch_out'] &&
        data.attendanceDate is string && data.attendanceDate.matches('^\\d{4}-\\d{2}-\\d{2}$') &&
        isOptionalStringSize(data, 'timezone', 80) &&
        isStringSize(data.title, 1, 160) &&
        isStringSize(data.body, 1, 400) &&
        isOptionalStringSize(data, 'url', 240) &&
        data.status in ['sent', 'failed', 'expired', 'skipped'] &&
        isOptionalStringSize(data, 'reason', 240) &&
        isOptionalStringSize(data, 'subscriptionId', 128) &&
        isOptionalStringSize(data, 'deviceLabel', 120) &&
        isOptionalStringSize(data, 'failureDetail', 300) &&
        isStringSize(data.sentAtIso, 10, 40);
    }

    function getCallerDepartment() {
      return get(/databases/$(database)/documents/employees/$(get(/databases/$(database)/documents/roles/$(request.auth.uid)).data.employeeId)).data.department;
    }

    // --- Collection Rules ---

    match /test/{docId} {
      allow get: if hasAuth();
    }

    match /companySettings/{settingId} {
      allow get: if hasAuth() && isValidId(settingId);
      allow list: if isSuperAdmin();
      allow create, update: if isSuperAdmin() && isValidId(settingId) && isValidCompanySettings(incoming());
      allow delete: if false;
    }

    match /departments/{deptId} {
      allow get: if hasAuth() && isValidId(deptId);
      allow list: if isActiveEmployee();
      allow create: if isSuperAdmin() && isValidId(deptId) && isValidDepartment(incoming()) && incoming().createdAt == request.time;
      allow update: if isSuperAdmin() && isValidId(deptId) && isValidDepartment(incoming()) && incoming().createdAt == existing().createdAt;
      allow delete: if isSuperAdmin() && isValidId(deptId);
    }

    match /roles/{uid} {
      allow get: if hasAuth() && isValidId(uid) && (request.auth.uid == uid || isSuperAdmin());
      allow list: if isSuperAdmin();
      allow create: if isValidId(uid) && isValidRoleEntry(incoming()) && (
        isSuperAdmin() ||
        (isBootstrappedAdmin() && uid == request.auth.uid && incoming().role == 'super_admin') ||
        (hasAuth() && uid == request.auth.uid &&
          exists(/databases/$(database)/documents/employees/$(incoming().employeeId)) &&
          get(/databases/$(database)/documents/employees/$(incoming().employeeId)).data.role == incoming().role &&
          get(/databases/$(database)/documents/employees/$(incoming().employeeId)).data.status == incoming().status &&
          (
            get(/databases/$(database)/documents/employees/$(incoming().employeeId)).data.uid == request.auth.uid ||
            (hasVerifiedEmail() &&
             get(/databases/$(database)/documents/employees/$(incoming().employeeId)).data.uid == '' &&
             get(/databases/$(database)/documents/employees/$(incoming().employeeId)).data.email == request.auth.token.email)
          ))
      );
      allow update: if isValidId(uid) && isValidRoleEntry(incoming()) && (
        isSuperAdmin() ||
        (isBootstrappedAdmin() && uid == request.auth.uid && incoming().role == 'super_admin')
      );
      allow delete: if isSuperAdmin() && isValidId(uid);
    }

    match /employees/{employeeId} {
      allow get: if hasAuth() && isValidId(employeeId) && (
        isSuperAdmin() ||
        (isActiveEmployee() && resource == null) ||
        (resource != null && (
          existing().uid == request.auth.uid ||
          (hasVerifiedEmail() && existing().email == request.auth.token.email) ||
          (isTeamLeader() && (existing().managerUid == request.auth.uid || hasLeaderPermission('canViewAllEmployees')))
        ))
      );
      allow list: if hasAuth() && (
        isBootstrappedAdmin() ||
        resource.data.uid == request.auth.uid ||
        (hasVerifiedEmail() && resource.data.email == request.auth.token.email) ||
        resource.data.managerUid == request.auth.uid ||
        isSuperAdmin() ||
        hasLeaderPermission('canViewAllEmployees')
      );
      allow create: if isValidId(employeeId) && isValidEmployee(incoming()) && incoming().createdAt == request.time && (
        isSuperAdmin() ||
        (isBootstrappedAdmin() && incoming().email == request.auth.token.email && incoming().role == 'super_admin')
      );
      allow update: if isValidId(employeeId) && (
        (isValidEmployee(incoming()) && incoming().createdAt == existing().createdAt && (
          isSuperAdmin() ||
          (hasLeaderPermission('canApproveLeaves') &&
            incoming().diff(existing()).affectedKeys().hasOnly(['sickLeaveBalance', 'casualLeaveBalance', 'carryForwardBalance', 'updatedAt'])) ||
          (hasVerifiedEmail() && existing().email == request.auth.token.email && (existing().uid == '' || existing().uid == request.auth.uid) &&
            incoming().uid == request.auth.uid &&
            incoming().diff(existing()).affectedKeys().hasOnly(['uid', 'mustChangePassword', 'failedLoginAttempts', 'lockedUntil', 'updatedAt'])) ||
          (hasAuth() && existing().uid == request.auth.uid && existing().status == 'Active' &&
            incoming().diff(existing()).affectedKeys().hasOnly(['phone', 'emergencyContact', 'profilePhotoAssetId', 'mustChangePassword', 'reminderPreferences', 'updatedAt']))
        )) ||
        (hasAuth() &&
          existing().uid == request.auth.uid &&
          existing().status == 'Active' &&
          incoming().mustChangePassword == false &&
          incoming().updatedAt == request.time &&
          incoming().diff(existing()).affectedKeys().hasOnly(['mustChangePassword', 'updatedAt']))
      );
      allow delete: if isSuperAdmin() && isValidId(employeeId);
    }

    match /employeeSalaries/{employeeId} {
      allow get: if isValidId(employeeId) && (isSuperAdmin() || hasLeaderPermission('canViewSalary'));
      allow list: if isSuperAdmin() || hasLeaderPermission('canViewSalary');
      allow create, update: if isValidId(employeeId) && isSuperAdmin() && isValidEmployeeSalary(incoming());
      allow delete: if isValidId(employeeId) && isSuperAdmin();
    }

    match /attendanceRecords/{recordId} {
      allow get: if hasAuth() && isValidId(recordId) && (
        isSuperAdmin() ||
        (isActiveEmployee() && resource == null) ||
        (resource != null && (
          existing().employeeUid == request.auth.uid ||
          (isTeamLeader() && (existing().managerUid == request.auth.uid || hasLeaderPermission('canViewAllEmployees')))
        ))
      );
      allow list: if hasAuth() && (
        isBootstrappedAdmin() ||
        resource.data.employeeUid == request.auth.uid ||
        resource.data.managerUid == request.auth.uid ||
        isSuperAdmin() ||
        hasLeaderPermission('canViewAllEmployees')
      );
      allow create: if isValidId(recordId) && isValidAttendanceRecord(incoming()) && incoming().createdAt == request.time && (
        isSuperAdmin() ||
        hasLeaderPermission('canEditAttendance') ||
        hasLeaderPermission('canApproveCorrections') ||
        (isActiveEmployee() && incoming().employeeUid == request.auth.uid)
      );
      allow update: if isValidId(recordId) && isValidAttendanceRecord(incoming()) && incoming().createdAt == existing().createdAt && (
        isSuperAdmin() ||
        hasLeaderPermission('canEditAttendance') ||
        hasLeaderPermission('canApproveCorrections') ||
        (isActiveEmployee() && existing().employeeUid == request.auth.uid &&
          incoming().employeeUid == existing().employeeUid &&
          incoming().employeeId == existing().employeeId &&
          incoming().date == existing().date && (
          ((!( 'punchInTime' in existing() ) || existing().punchInTime == '') &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'timezone', 'punchInTime', 'punchInLat', 'punchInLng', 'punchInAccuracy',
              'punchInPhotoId', 'workingMinutes', 'status', 'isLate', 'lateByMinutes', 'updatedAt'
            ])) ||
          ((!( 'punchOutTime' in existing() ) || existing().punchOutTime == '') &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'punchOutTime', 'punchOutLat', 'punchOutLng', 'punchOutAccuracy',
              'punchOutPhotoId', 'workingMinutes', 'status', 'updatedAt'
            ]))
        ))
      );
      allow delete: if isSuperAdmin() && isValidId(recordId);
    }

    match /attendancePhotos/{photoId} {
      allow get: if hasAuth() && isValidId(photoId) && (
        isSuperAdmin() ||
        (isActiveEmployee() && resource == null) ||
        (resource != null && (
          existing().employeeUid == request.auth.uid ||
          isTeamLeader()
        ))
      );
      allow list: if hasAuth() && (
        isBootstrappedAdmin() ||
        resource.data.employeeUid == request.auth.uid ||
        isSuperAdmin() ||
        isTeamLeader()
      );
      allow create: if isValidId(photoId) && isValidAttendancePhoto(incoming()) && isActiveEmployee() &&
        (incoming().employeeUid == request.auth.uid || isSuperAdmin());
      allow update: if false;
      allow delete: if isSuperAdmin() && isValidId(photoId);
    }

    match /mediaAssets/{assetId} {
      allow get: if hasAuth() && isValidId(assetId) && (
        (isActiveEmployee() && resource == null) ||
        (resource != null && (
          existing().assetType == 'company_logo' ||
          existing().assetType == 'profile_photo' ||
          existing().ownerUid == request.auth.uid ||
          isLeaderOrAdmin()
        ))
      );
      allow list: if hasAuth() && (
        isBootstrappedAdmin() ||
        resource.data.ownerUid == request.auth.uid ||
        resource.data.assetType == 'company_logo' ||
        isLeaderOrAdmin()
      );
      allow create: if isValidId(assetId) && isValidMediaAsset(incoming()) && isActiveEmployee() &&
        (incoming().ownerUid == request.auth.uid || isSuperAdmin());
      allow update: if false;
      allow delete: if isValidId(assetId) && (isSuperAdmin() || (hasAuth() && resource != null && existing().ownerUid == request.auth.uid));
    }

    match /attendanceCorrections/{correctionId} {
      allow get: if hasAuth() && isValidId(correctionId) && (
        isSuperAdmin() ||
        hasLeaderPermission('canApproveCorrections') ||
        (isActiveEmployee() && resource == null) ||
        (resource != null && existing().employeeUid == request.auth.uid)
      );
      allow list: if hasAuth() && (
        isBootstrappedAdmin() ||
        isSuperAdmin() ||
        hasLeaderPermission('canApproveCorrections') ||
        resource.data.employeeUid == request.auth.uid
      );
      allow create: if isValidId(correctionId) && isValidAttendanceCorrection(incoming()) &&
        incoming().createdAt == request.time &&
        incoming().status == 'Pending' &&
        isActiveEmployee() &&
        incoming().employeeUid == request.auth.uid;
      allow update: if isValidId(correctionId) && isValidAttendanceCorrection(incoming()) &&
        incoming().createdAt == existing().createdAt &&
        existing().status == 'Pending' &&
        incoming().status in ['Approved', 'Rejected'] &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'status', 'reviewedBy', 'reviewedByName', 'reviewedByRole', 'reviewComment', 'reviewedAt', 'appliedChanges'
        ]) && (
          isSuperAdmin() ||
          (hasLeaderPermission('canApproveCorrections') && existing().employeeUid != request.auth.uid)
        );
      allow delete: if isSuperAdmin() && isValidId(correctionId);
    }

    match /regularizationLocks/{lockId} {
      allow get: if hasAuth() && isValidId(lockId) && (
        isSuperAdmin() ||
        hasLeaderPermission('canApproveCorrections') ||
        (isActiveEmployee() && resource == null) ||
        (resource != null && existing().employeeUid == request.auth.uid)
      );
      allow list: if false;
      allow create: if isValidId(lockId) &&
        isActiveEmployee() &&
        isValidRegularizationLock(incoming()) &&
        incoming().employeeUid == request.auth.uid &&
        lockId == (incoming().employeeId + '_' + incoming().date + '_' + incoming().requestType);
      allow update: if false;
      allow delete: if isValidId(lockId) && (
        isSuperAdmin() ||
        (hasLeaderPermission('canApproveCorrections') && (resource == null || existing().employeeUid != request.auth.uid))
      );
    }

    match /hrNotifications/{notifId} {
      allow get: if hasAuth() && isValidId(notifId) && isActiveEmployee() && (
        isSuperAdmin() ||
        resource == null ||
        (resource != null && (
          existing().targetUid == request.auth.uid ||
          (existing().audienceType == 'reviewers' && hasLeaderPermission('canApproveCorrections'))
        ))
      );
      allow list: if isBootstrappedAdmin() || isSuperAdmin() || (
        isActiveEmployee() && (
          resource.data.targetUid == request.auth.uid ||
          (resource.data.audienceType == 'reviewers' && hasLeaderPermission('canApproveCorrections'))
        )
      );
      allow create: if isValidId(notifId) &&
        isActiveEmployee() &&
        isValidHrNotification(incoming()) && (
          (incoming().audienceType == 'user' && (
            incoming().targetUid == request.auth.uid ||
            isSuperAdmin() ||
            hasLeaderPermission('canApproveCorrections')
          )) ||
          (incoming().audienceType == 'reviewers' && incoming().eventType == 'submitted_admin')
        );
      allow update: if false;
      allow delete: if isValidId(notifId) && isSuperAdmin();
    }

    match /leaveApplications/{leaveId} {
      allow get: if hasAuth() && isValidId(leaveId) && (
        isSuperAdmin() ||
        isTeamLeader() ||
        (isActiveEmployee() && resource == null) ||
        (resource != null && existing().employeeUid == request.auth.uid)
      );
      allow list: if hasAuth() && (
        isBootstrappedAdmin() ||
        resource.data.employeeUid == request.auth.uid ||
        resource.data.managerUid == request.auth.uid ||
        isSuperAdmin() ||
        isTeamLeader()
      );
      allow create: if isValidId(leaveId) && isValidLeaveApplication(incoming()) &&
        incoming().createdAt == request.time &&
        incoming().status == 'Pending' &&
        incoming().balanceDeducted == false &&
        incoming().deductedAmount == 0 &&
        isActiveEmployee() &&
        incoming().employeeUid == request.auth.uid;
      allow update: if isValidId(leaveId) && isValidLeaveApplication(incoming()) &&
        incoming().createdAt == existing().createdAt && (
        isSuperAdmin() ||
        (hasLeaderPermission('canApproveLeaves') &&
          existing().employeeUid != request.auth.uid &&
          existing().status == 'Pending' &&
          incoming().status in ['Approved', 'Rejected'] &&
          incoming().diff(existing()).affectedKeys().hasOnly(['status', 'balanceDeducted', 'deductedAmount', 'reviewedBy', 'reviewedByName', 'reviewComment', 'reviewedAt'])) ||
        (isActiveEmployee() && existing().employeeUid == request.auth.uid && existing().status == 'Pending' &&
          incoming().status == 'Cancelled' &&
          incoming().diff(existing()).affectedKeys().hasOnly(['status']))
      );
      allow delete: if isSuperAdmin() && isValidId(leaveId);
    }

    match /leaveLedger/{entryId} {
      allow get: if hasAuth() && isValidId(entryId) && (
        isSuperAdmin() ||
        isTeamLeader() ||
        (isActiveEmployee() && resource == null) ||
        (resource != null && (
          existing().employeeUid == request.auth.uid ||
          (hasVerifiedEmail() && existing().employeeEmail == request.auth.token.email)
        ))
      );
      allow list: if hasAuth() && (
        isBootstrappedAdmin() ||
        isSuperAdmin() ||
        isTeamLeader() ||
        resource.data.employeeUid == request.auth.uid ||
        (hasVerifiedEmail() && resource.data.employeeEmail == request.auth.token.email)
      );
      allow create: if isValidId(entryId) && isValidLeaveLedgerEntry(incoming()) &&
        incoming().createdAt == request.time && (
          isSuperAdmin() ||
          (hasLeaderPermission('canApproveLeaves') && incoming().entryType in ['approved_deduction', 'leave_reversal'])
        );
      allow update, delete: if false;
    }

    match /payrollRecords/{payrollId} {
      allow get: if hasAuth() && isValidId(payrollId) && (
        isSuperAdmin() ||
        hasLeaderPermission('canViewSalary') ||
        (isActiveEmployee() && resource == null) ||
        (resource != null && existing().employeeUid == request.auth.uid && existing().status == 'Published')
      );
      allow list: if hasAuth() && (
        isBootstrappedAdmin() ||
        isSuperAdmin() ||
        hasLeaderPermission('canViewSalary') ||
        (resource.data.employeeUid == request.auth.uid && resource.data.status == 'Published')
      );
      allow create: if isValidId(payrollId) && isSuperAdmin() && isValidPayrollRecord(incoming()) && incoming().createdAt == request.time;
      allow update: if isValidId(payrollId) && isSuperAdmin() && isValidPayrollRecord(incoming()) && incoming().createdAt == existing().createdAt;
      allow delete: if isValidId(payrollId) && isSuperAdmin();
    }

    match /auditLogs/{logId} {
      allow get: if isValidId(logId) && isSuperAdmin();
      allow list: if isBootstrappedAdmin() || isSuperAdmin();
      allow create: if isValidId(logId) && isValidAuditLog(incoming()) && isActiveEmployee();
      allow update, delete: if false;
    }

    match /celebrationProfiles/{employeeId} {
      allow get: if isValidId(employeeId) && isActiveEmployee();
      allow list: if isActiveEmployee();
      allow create, update: if isValidId(employeeId) && isValidCelebrationProfile(incoming()) && (
        isSuperAdmin() ||
        (isActiveEmployee() &&
          incoming().employeeId == employeeId &&
          incoming().employeeUid == request.auth.uid &&
          exists(/databases/$(database)/documents/employees/$(employeeId)) &&
          get(/databases/$(database)/documents/employees/$(employeeId)).data.uid == request.auth.uid &&
          incoming().status == get(/databases/$(database)/documents/employees/$(employeeId)).data.status &&
          incoming().joiningDate == get(/databases/$(database)/documents/employees/$(employeeId)).data.joiningDate &&
          (!( 'birthdayMonthDay' in incoming() ) ||
            incoming().birthdayMonthDay == get(/databases/$(database)/documents/employees/$(employeeId)).data.get('birthdayMonthDay', '') ||
            ('dateOfBirth' in get(/databases/$(database)/documents/employees/$(employeeId)).data &&
             get(/databases/$(database)/documents/employees/$(employeeId)).data.dateOfBirth is string &&
             get(/databases/$(database)/documents/employees/$(employeeId)).data.dateOfBirth.size() == 10 &&
             get(/databases/$(database)/documents/employees/$(employeeId)).data.dateOfBirth[5:10] == incoming().birthdayMonthDay)))
      );
      allow delete: if isValidId(employeeId) && isSuperAdmin();
    }

    match /celebrationNotifications/{notificationId} {
      allow get: if isValidId(notificationId) && isActiveEmployee() && (
        isSuperAdmin() ||
        resource == null ||
        (resource != null && (
          existing().employeeUid == request.auth.uid ||
          existing().audienceScope == 'all_active' ||
          (existing().audienceScope == 'leaders_only' && isLeaderOrAdmin()) ||
          (existing().audienceScope == 'department' && existing().department == getCallerDepartment())
        ))
      );
      allow list: if isBootstrappedAdmin() || isSuperAdmin() || (
        isActiveEmployee() && (
          resource.data.audienceScope == 'all_active' ||
          resource.data.employeeUid == request.auth.uid ||
          (resource.data.audienceScope == 'leaders_only' && isTeamLeader()) ||
          (resource.data.audienceScope == 'department' && resource.data.department == getCallerDepartment())
        )
      );
      allow create: if isValidId(notificationId) &&
        isActiveEmployee() &&
        isValidCelebrationNotification(incoming()) &&
        notificationId == ('cel_' + incoming().type + '_' + incoming().employeeId + '_' + string(incoming().year)) &&
        exists(/databases/$(database)/documents/celebrationProfiles/$(incoming().employeeId)) &&
        get(/databases/$(database)/documents/celebrationProfiles/$(incoming().employeeId)).data.status == 'Active';
      allow update: if false;
      allow delete: if isValidId(notificationId) && isSuperAdmin();
    }

    match /notificationReads/{readId} {
      allow get: if isValidId(readId) && hasAuth() && (
        (isActiveEmployee() && resource == null) ||
        (resource != null && existing().uid == request.auth.uid)
      );
      allow list: if hasAuth() && resource.data.uid == request.auth.uid;
      allow create, update: if isValidId(readId) &&
        isActiveEmployee() &&
        isValidNotificationRead(incoming()) &&
        readId == (request.auth.uid + '_' + incoming().notificationId) && (
          exists(/databases/$(database)/documents/celebrationNotifications/$(incoming().notificationId)) ||
          exists(/databases/$(database)/documents/hrNotifications/$(incoming().notificationId))
        );
      allow delete: if isValidId(readId) && hasAuth() && (isSuperAdmin() || (resource != null && existing().uid == request.auth.uid));
    }

    match /celebrationWishes/{wishId} {
      allow get: if isValidId(wishId) && isActiveEmployee();
      allow list: if isActiveEmployee();
      allow create: if isValidId(wishId) &&
        isActiveEmployee() &&
        isValidCelebrationWish(incoming()) &&
        exists(/databases/$(database)/documents/celebrationNotifications/$(incoming().notificationId)) &&
        (!exists(/databases/$(database)/documents/companySettings/main) ||
          get(/databases/$(database)/documents/companySettings/main).data.get('celebrationSettings', {}).get('wishesEnabled', true) == true);
      allow update: if false;
      allow delete: if isValidId(wishId) && (
        isSuperAdmin() ||
        (isActiveEmployee() && resource != null && existing().authorUid == request.auth.uid)
      );
    }

    match /pushSubscriptions/{subId} {
      allow get: if hasAuth() && isValidId(subId) && (
        (isActiveEmployee() && resource == null) ||
        (resource != null && existing().employeeUid == request.auth.uid)
      );
      allow list: if hasAuth() && resource.data.employeeUid == request.auth.uid;
      allow create, update: if hasAuth() && isValidId(subId) && isActiveEmployee() && isValidPushSubscription(incoming());
      allow delete: if hasAuth() && isValidId(subId) && resource != null && existing().employeeUid == request.auth.uid;
    }

    match /attendanceReminderLogs/{logId} {
      allow get: if hasAuth() && isValidId(logId) && (
        isSuperAdmin() ||
        (isActiveEmployee() && resource == null) ||
        (resource != null && existing().employeeUid == request.auth.uid)
      );
      allow list: if isBootstrappedAdmin() || isSuperAdmin() || (
        hasAuth() && resource.data.employeeUid == request.auth.uid
      );
      allow create: if isValidId(logId) && isActiveEmployee() && isValidAttendanceReminderLog(incoming()) && (
        isSuperAdmin() ||
        incoming().employeeUid == request.auth.uid
      );
      allow update: if false;
      allow delete: if isSuperAdmin() && isValidId(logId);
    }
  }
}
