{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.ts": {
      "includeFiles": "{fonts/**,firebase-applet-config.json}"
    },
    "api/payslips/pdf.ts": {
      "includeFiles": "{fonts/**,firebase-applet-config.json}"
    }
  },
  "rewrites": [
    {
      "source": "/api/((?!server-time$|payslips/pdf$).*)",
      "destination": "/api/index?__path=/api/$1"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
