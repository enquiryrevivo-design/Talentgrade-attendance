        "attendanceReminders": { "type": "object" },
        "currency": { "type": "string", "maxLength": 10 },
        "teamLeaderPermissions": { "type": "object" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "updatedBy": { "type": "string", "maxLength": 128 }
      },
      "required": [
        "companyName",
        "officeStartTime",
        "officeEndTime",
        "gracePeriodMinutes",
        "halfDayMinHours",
        "fullDayMinHours",
        "workingDays",
        "defaultSickLeave",
        "defaultCasualLeave",
        "currency",
        "teamLeaderPermissions",
        "updatedAt",
        "updatedBy"
      ]
    },
