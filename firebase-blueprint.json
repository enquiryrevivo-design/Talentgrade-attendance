    "AttendanceCorrection": {
      "title": "AttendanceCorrection",
      "description": "Employee attendance regularization request to correct missed or inaccurate punch-in/punch-out records.",
      "type": "object",
      "properties": {
        "employeeId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "employeeUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "employeeCode": { "type": "string", "maxLength": 40 },
        "employeeName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "department": { "type": "string", "minLength": 1, "maxLength": 80 },
        "managerUid": { "type": "string", "maxLength": 128 },
        "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "timezone": { "type": "string", "maxLength": 80 },
        "attendanceRecordId": { "type": "string", "minLength": 1, "maxLength": 160 },
        "requestType": {
          "type": "string",
          "enum": ["missed_punch_in", "missed_punch_out", "both_missed", "incorrect_punch", "other_discrepancy"]
        },
        "requestedPunchIn": { "type": "string", "pattern": "^(?:([01]\\d|2[0-3]):[0-5]\\d)?$" },
        "requestedPunchOut": { "type": "string", "pattern": "^(?:([01]\\d|2[0-3]):[0-5]\\d)?$" },
        "originalPunchInTime": { "type": "string", "maxLength": 40 },
        "originalPunchOutTime": { "type": "string", "maxLength": 40 },
        "originalStatus": {
          "type": "string",
          "enum": ["Present", "Late", "Half Day", "Absent", "Leave", "Incomplete Attendance", "Holiday", "Weekly Off"]
        },
        "originalWorkingMinutes": { "type": "number" },
        "reason": { "type": "string", "minLength": 3, "maxLength": 500 },
        "attachmentAssetId": { "type": "string", "maxLength": 128 },
        "status": { "type": "string", "enum": ["Pending", "Approved", "Rejected"] },
        "reviewedBy": { "type": "string", "maxLength": 128 },
        "reviewedByName": { "type": "string", "maxLength": 120 },
        "reviewedByRole": { "type": "string", "enum": ["super_admin", "team_leader", "employee"] },
        "reviewComment": { "type": "string", "maxLength": 500 },
        "appliedChanges": { "type": "object" },
        "submittedAtIso": { "type": "string", "maxLength": 40 },
        "reviewedAt": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "employeeId",
        "employeeUid",
        "employeeName",
        "department",
        "date",
        "attendanceRecordId",
        "requestedPunchIn",
        "requestedPunchOut",
        "reason",
        "status",
        "createdAt"
      ]
    },
